# Copy to .env and fill in. .env is in .gitignore, never commit it.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Default is the current Flash model alias
GEMINI_MODEL=gemini-flash-latest

# Free M0 cluster: https://cloud.mongodb.com  (mongodb+srv://user:pass@cluster.../)
MONGODB_URI=

# Who gets the iMessage / FaceTime. Phone in +1XXXXXXXXXX form, or an iMessage email.
FAMILY_PHONE=
FAMILY_NAME=
GRANDMA_NAME=Grandma

# Trusted-contact verification (optional). Extra contacts: "Maya:+12145550123,Sam:+12145550199"
TRUSTED_CONTACTS=
# Private family emergency phrase used only during verification replies. Never share it in texts to Grandma.
VERIFY_PHRASE=
# How far back Scam Memory looks for multi-message patterns (days).
SCAM_MEMORY_DAYS=14

# Voice. Leave TROJAN_VOICE empty to auto-pick the best installed voice.
TROJAN_VOICE=
TROJAN_RATE=155

# Recommended: Fish Audio (same TTS used by Cal Hacks 12.0 FaceTimeOS winners).
# Free key: https://fish.audio/app/api-keys/  — Hermes prefers this when set.
FISH_API_KEY=
# Optional voice model id from https://fish.audio (empty = Fish default)
FISH_VOICE_ID=

# Optional alternate: ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Free fallback voice via GEMINI_API_KEY. "off" = Mac `say` only.
# Kore = clear/firm. Others: Aoede, Sulafat, Achernar, Vindemiatrix
GEMINI_VOICE=Kore
# Product name (shown in the app, spoken wake word, family messages).
# Hermes = Odyssey messenger who helped Odysseus see through Circe's tricks.
APP_NAME=Hermes
# Optional: comma-separated wake words / mishearings. Empty = sensible defaults for the name.
WAKE_WORDS=

# Accounts live on this Mac in data/accounts.json. The one-time code is sent by iMessage.
# Set to 1 only while testing: the code is printed in the terminal instead of sent.
AUTH_DEV_CODES=
# Background guard for messages from numbers not saved in Contacts. "off" disables it.
WATCH_MESSAGES=
